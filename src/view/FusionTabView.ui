      <widget class="QSlider" name="paramSlider">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>100</number></property>
       <property name="value"><number>50</number></property>
      </widget>
     </item>
     <item><widget class="QLabel" name="sliceLabel"><property name="text"><string>切片 Z</string></property></widget></item>
     <item><widget class="QSlider" name="sliceSlider"><property name="orientation"><enum>Qt::Horizontal</enum></property></widget></item>
    </layout>
   </item>
   <item alignment="Qt::AlignHCenter">
    <widget class="QLabel" name="fusionView">
     <property name="minimumSize"><size><width>300</width><height>300</height></size></property>
     <property name="maximumSize"><size><width>300</width><height>300</height></size></property>
     <property name="alignment"><set>Qt::AlignCenter</set></property>
     <property name="text"><string>请先在'配准'标签页运行配准</string></property>
    </widget>
   </item>
  </layout>
