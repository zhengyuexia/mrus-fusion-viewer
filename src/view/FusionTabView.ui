<ui version="4.0">
 <class>FusionTabView</class>
 <widget class="QWidget" name="FusionTabView">
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <layout class="QHBoxLayout" name="controlRow">
     <item><widget class="QLabel" name="modeLabel"><property name="text"><string>方式</string></property></widget></item>
     <item>
      <widget class="QComboBox" name="modeCombo">
